# Sem estas duas variáveis a aplicação corre em modo demonstração:
# os dados vivem no navegador e mudam em tempo real entre separadores.
#
# Com elas, passa a usar o Supabase (Auth + Postgres + Realtime).
# Correr antes as migrações de supabase/migrations por ordem.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Número da clínica no formato internacional, sem + nem espaços (244XXXXXXXXX).
# Só é usado enquanto a tabela clinic_settings não tiver valor.
VITE_WHATSAPP_CLINICA=244923000000
